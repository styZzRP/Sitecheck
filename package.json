{
  "name": "sitecheck",
  "version": "1.0.0",
  "private": true,
  "description": "Free security, SEO, AEO and health scanner for vibe-coded apps",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "next-on-pages",
    "preview": "next-on-pages && wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "deploy": "next-on-pages && wrangler pages deploy"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vercel": "^37.14.0",
    "wrangler": "^3.99.0"
  }
}
